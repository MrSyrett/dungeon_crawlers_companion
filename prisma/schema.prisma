// Dungeon Desk — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  // New accounts start unapproved and can't sign in until an admin approves
  // them (admins are auto-approved on signup). Existing accounts were backfilled
  // to true by the migration so this gate only affects people who join later.
  approved     Boolean    @default(false)

  sessions  Session[]
  documents Document[]
  campaigns Campaign[]
  homebrew  Homebrew[]
  vttTokens VttToken[]
  rulebookAccess RulebookAccess[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One saved sheet / session-prep document. `data` holds the tool's JSON blob
// (the same shape the original tool wrote to localStorage), keyed in the app
// by the localStorage key(s) that tool uses.
model Document {
  id        String   @id @default(cuid())
  userId    String
  tool      String // "dcc-character" | "dcc-session" | "sd-character" | "sd-session" | "gm-screen"
  // For "gm-screen" docs this scopes the saved board to a campaign:
  //   null      → the personal "unlinked" scratch board
  //   <cuid>    → the board for that campaign (per user)
  // Character-sheet docs leave this null; their campaign link lives in
  // `linkedCampaignId` (an indexed column) instead — see below.
  campaignId String?
  // For "sd-character" docs: the campaign the sheet is linked to, promoted out
  // of the sheet JSON (`data.sd_sheet` → `_sheet.campaign.id`) into an indexed
  // column so the party roster / campaign membership lookups are index scans
  // rather than full-table string_contains scans. Deleting the campaign nulls
  // this (SetNull) rather than deleting the player's character (Cascade would).
  linkedCampaignId String?
  title      String   @default("Untitled")
  data       Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign        Campaign? @relation("DocumentBoardCampaign", fields: [campaignId], references: [id], onDelete: Cascade)
  linkedCampaign  Campaign? @relation("DocumentLinkedCampaign", fields: [linkedCampaignId], references: [id], onDelete: SetNull)

  @@index([userId, tool, campaignId])
  @@index([userId, tool, updatedAt])
  @@index([tool, linkedCampaignId])
}

// A campaign links multiple players' tools together. Anyone with the join
// code can connect; rolls broadcast to every connected tool's roll log.
model Campaign {
  id        String   @id @default(cuid())
  name      String   @default("New Campaign")
  code      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  // Link to the table's virtual tabletop room (e.g. an Owlbear Rodeo room).
  // Stored as given; only ever http(s), validated before it's written.
  vttUrl    String?

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rolls CampaignRoll[]
  homebrewShares HomebrewShare[]
  // Per-user GM-screen boards saved for this campaign (tool = "gm-screen").
  // Deleting the campaign removes them, so a stale board can't outlive it.
  documents Document[] @relation("DocumentBoardCampaign")
  // Character sheets linked to this campaign (tool = "sd-character"). Deleting
  // the campaign nulls their link (SetNull) rather than removing the sheets.
  linkedDocuments Document[] @relation("DocumentLinkedCampaign")
}

// A user-owned homebrew entry: a spell, gear item, monster, class, ancestry, or
// background. `data` holds the same object shape the character sheet / GM screen
// already use (a spell in SD_SPELLS shape, gear in `_homebrewItems` shape, a
// monster in SD_MONSTERS shape, etc.), so those tools can merge it into their
// catalogs and use it with no translation.
//
// Ownership is per user (the owner manages it). Sharing is a many-to-many via
// HomebrewShare: an entry with no shares is personal; each share makes it usable
// by everyone whose sheet is linked to that campaign.
model Homebrew {
  id        String   @id @default(cuid())
  ownerId   String
  type      String // "spell" | "gear" | "monster" | "class" | "ancestry" | "background"
  name      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shares HomebrewShare[]

  @@index([ownerId])
}

// An access token for a virtual tabletop (Owlbear Rodeo). The app's session
// cookie is SameSite=Lax, so it is never sent when a page of ours is framed by
// another site — a VTT needs its own credential.
//
// Deliberately narrow: a token only ever grants read + save on its owner's
// CHARACTER SHEETS. It cannot touch campaigns, homebrew, or delete anything, so
// pasting one into a VTT can't cost more than the sheets it is for.
//
// Only a SHA-256 hash is stored. The token is shown once at creation; losing it
// means creating a new one, which is cheap.
model VttToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  // The code in plain form, so the VTT page can show it again on demand. This is
  // a convenience/security trade-off: a leaked DB now exposes usable codes (each
  // grants only read + save on its owner's character sheets). Null for codes
  // created before this was stored — those can only be revoked and remade.
  token     String?
  // First few characters, so the owner can tell tokens apart in the UI.
  prefix    String
  label     String
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Join row: one homebrew entry shared with one campaign. Deleting either side
// removes the share (a deleted campaign simply makes the entry personal again).
model HomebrewShare {
  homebrewId String
  campaignId String

  homebrew Homebrew @relation(fields: [homebrewId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([homebrewId, campaignId])
  @@index([campaignId])
}

model CampaignRoll {
  id         Int      @id @default(autoincrement())
  campaignId String
  clientKey  String   @default("")
  source     String
  label      String
  result     String
  detail     String   @default("")
  type       String   @default("normal")
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, id])
}

// ── Sound library ────────────────────────────────────────────────────────────
// A shared, admin-managed shelf of labeled audio URLs for the GM Screen Music
// tool. Instead of re-pasting a track's direct link every session, an admin
// saves it here once (with a friendly label and a category) and the Music tool's
// "Library" picker pulls from it. Not user-scoped: there is one library the
// whole table draws from, and only admins (ADMIN_EMAILS) can read or edit it.
//
// `url` is stored already-normalized to a directly playable form (e.g. Dropbox
// share links rewritten to raw=1) so the picker can hand it to <audio> as-is.
model Sound {
  id        String   @id @default(cuid())
  label     String
  url       String
  category  String   @default("Uncategorized")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ── Rulebook access control ──────────────────────────────────────────────────
// Rulebook PDFs live on disk in protected/rulebooks/ (never under public/), keyed
// by filename. These two tables gate who may read each file. Default is PRIVATE:
// a file with no Rulebook row and no grants is visible only to admins
// (ADMIN_EMAILS) — the safe default for copyrighted material.

// Per-file visibility switch. everyone=true opens a file to any signed-in user;
// otherwise access is admin-only plus whoever has an explicit grant below.
model Rulebook {
  file      String   @id // filename in protected/rulebooks/
  everyone  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A grant: this user may read this rulebook file. Deleting the user removes it.
model RulebookAccess {
  file      String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([file, userId])
  @@index([userId])
  @@index([file])
}
